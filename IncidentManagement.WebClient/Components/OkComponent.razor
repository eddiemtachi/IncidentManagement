<div class="popup-overlay" style="@(_isVisible ? "display:flex;" : "display:none;")">
    <div class="popup-box">
        <h3>@Title</h3>
        <p>@Message</p>
        <button class="btn-action" @onclick="OnOkClicked">Okay</button>
    </div>
</div>

@code {
    private bool _isVisible;

    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public EventCallback OnOk { get; set; }

    public void Show(string title, string message)
    {
        Title = title;
        Message = message;
        _isVisible = true;
        StateHasChanged();
    }

    private async Task OnOkClicked()
    {
        _isVisible = false;
        await OnOk.InvokeAsync();
    }
}
