@page "/incidents"
@layout DashboardLayout
@using IncidentManagement.Application.Dtos.Requests
@using IncidentManagement.Shared.Models
@using IncidentManagement.Shared.Services
@using IncidentManagement.WebClient.Components
@using IncidentManagement.WebClient.Services
@inject IncidentService IncidentService
@inject AuthState AuthState
@inject UserService UserService

<ConfirmDialog @ref="confirmDialog"
               OnConfirm="ConfirmDelete"
               OnCancel="CancelDelete" />

<div class="profile-container">
    <h2>Incident Management</h2>

    <!-- Button to open modal -->
    <button class="add-btn" @onclick="ShowModal">➕ Add New Incident</button>

    <!-- Modal Popup -->
    @if (IsModalOpen)
    {
        <div class="modal-overlay">
            <div class="modal-content">
                <h3>Capture New Incident</h3>

                <label>Title</label>
                <input type="text" @bind="NewIncident.Title" />

                <label>Status</label>
                <select @bind="NewIncident.Status">
                    <option value="Open">Open</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Closed">Closed</option>
                </select>

                <label>Priority</label>
                <select @bind="NewIncident.Priority">
                    <option value="Low">Low</option>
                    <option value="Medium">Medium</option>
                    <option value="High">High</option>
                </select>

                <!-- Role Team dropdown -->
                <label>Role Team</label>
                <select @bind="SelectedRole">
                    <option value="">-- Select Role --</option>
                    @foreach (var role in Roles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>

                <label>Assigned To</label>
                <select @bind="NewIncident.AssignedTo">
                    @foreach (var user in FilteredUsersByRole)
                    {
                        <option value="@user.Username">@user.Username</option>
                    }
                </select>

                <label>Description</label>
                <textarea @bind="NewIncident.Description"></textarea>

                <div class="modal-actions">
                    <button class="cancel-btn" @onclick="CloseModal">Cancel</button>
                    <button class="save-btn" @onclick="SaveIncident">Save</button>
                </div>
            </div>
        </div>
    }

    <!-- Filters -->
    <p class="subtitle">Search, filter, capture, and manage incidents</p>
    <div class="filters">
        <input type="text" placeholder="Search by Title"
               value="@SearchTitle"
               @oninput="OnSearchChanged" />
        <select @bind="FilterStatus">
            <option value="">All Statuses</option>
            <option value="Open">Open</option>
            <option value="Closed">Closed</option>
            <option value="In Progress">In Progress</option>
        </select>
        <select @bind="FilterPriority">
            <option value="">All Priorities</option>
            <option value="Low">Low</option>
            <option value="Medium">Medium</option>
            <option value="High">High</option>
        </select>
        <select @bind="FilterAssignedTo">
            <option value="">All Assignees</option>
            @foreach (var user in Users)
            {
                <option value="@user.Username">@user.Username</option>
            }
        </select>
    </div>

    <!-- Incident Grid -->
    <table class="incident-table">
        <thead>
            <tr>
                <th>Incident ID</th>
                <th>Title</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Assigned To</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @* @foreach (var incident in PagedIncidents)
            {
                <tr>
                    <td>@incident.IncidentId</td>
                    <td>@incident.Title</td>
                    <td>@incident.Status</td>
                    <td>@incident.Priority</td>
                    <td>@incident.AssignedTo</td>
                    <td data-label="Actions">
                        <button class="icon-btn edit" data-tooltip="Edit Incident" @onclick="() => EditIncident(incident)">✏️</button>
                        <button class="icon-btn danger" data-tooltip="Delete Incident" @onclick="() => AskDeleteConfirmation(incident.IncidentId)">❌</button>
                    </td>
                </tr>
            } *@
        </tbody>
    </table>

    <!-- Paging -->
    @* <div class="paging-controls">
        <button @onclick="PreviousPage" disabled="@(!HasPrevious)">Previous</button>
        <span>Page @CurrentPage of @TotalPages</span>
        <button @onclick="NextPage" disabled="@(!HasNext)">Next</button>
    </div> *@
</div>

@code {
    private bool IsModalOpen = false;
    private Incident NewIncident = new();
    private List<User> Users = new();
    private List<string> Roles = new();
    private List<User> FilteredUsersByRole = new();

    private string SearchTitle = "";
    private string FilterStatus = "";
    private string FilterPriority = "";
    private string FilterAssignedTo = "";

    private int CurrentPage = 1;
    private int PageSize = 3;

    private ConfirmDialog confirmDialog;
    private int pendingIncidentId;

    protected override void OnInitialized()
    {
        Users = UserService.Users.ToList();
        Roles = Users.Where(x => x.Role != "Tenant" || x.Role != "Resident").Select(u => u.Role).Distinct().ToList();
        FilteredUsersByRole = new List<User>();
    }

    // Single property for binding
    private string SelectedRole
    {
        get => selectedRole;
        set
        {
            selectedRole = value;
            FilteredUsersByRole = string.IsNullOrEmpty(selectedRole)
