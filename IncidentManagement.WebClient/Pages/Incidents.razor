    private void EditIncident(Incident incident)
    {
        NewIncident = new Incident
        {
            IncidentId = incident.IncidentId,
            Title = incident.Title,
            Description = incident.Description,
            Status = incident.Status,
            Priority = incident.Priority,
            AssignedTo = incident.AssignedTo,
            CreatedDate = incident.CreatedDate,
        };

        var assignedUser = Users.FirstOrDefault(u => u.Username == incident.AssignedTo);
        if (assignedUser != null)
        {
            SelectedRole = assignedUser.Role;
            FilteredUsersByRole = Users.Where(u => u.Role == SelectedRole).ToList();
        }

        IsModalOpen = true;
    }

    private void AskDeleteConfirmation(int id)
