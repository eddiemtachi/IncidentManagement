    //                     .Any(word => i.Title.Contains(word, StringComparison.OrdinalIgnoreCase)))
    //         && (string.IsNullOrEmpty(FilterStatus) || i.Status == FilterStatus)
    //         && (string.IsNullOrEmpty(FilterPriority) || i.Priority == FilterPriority)
    //         && (string.IsNullOrEmpty(FilterAssignedTo) || i.AssignedTo == FilterAssignedTo)
    //     )
    //     .ToList();

    // private int TotalPages => (int)Math.Ceiling((double)FilteredIncidents.Count / PageSize);
    private bool HasPrevious => CurrentPage > 1;
    //private bool HasNext => CurrentPage < TotalPages;

    // private List<Incident> PagedIncidents => FilteredIncidents
    //     .Skip((CurrentPage - 1) * PageSize)
    //     .Take(PageSize)
    //     .ToList();

    private void PreviousPage() { if (HasPrevious) CurrentPage--; }
    // private void NextPage() { if (HasNext) CurrentPage++; }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        SearchTitle = e.Value?.ToString() ?? string.Empty;
        CurrentPage = 1;
    }

    private void ShowModal() => IsModalOpen = true;
    private void CloseModal()
    {
        IsModalOpen = false;
        NewIncident = new Incident();
        SelectedRole = "";
        FilteredUsersByRole.Clear();
    }

    private void SaveIncident()
    {
        CreateIncidentRequest createIncident = new CreateIncidentRequest(NewIncident.Title, NewIncident.Description,
            1, 1, 1, 1, 1, 1);
        // if (NewIncident.IncidentId > 0)
        // {
        //     IncidentService.UpdateIncident(createIncident);
        // }
        // else
        // {
            IncidentService.AddIncident(createIncident);
        //}
        

        CloseModal();
    }
    

    private void EditIncident(Incident incident)
    {
        NewIncident = new Incident
        {
            IncidentId = incident.IncidentId,
            Title = incident.Title,
            Description = incident.Description,
            Status = incident.Status,
            Priority = incident.Priority,
            AssignedTo = incident.AssignedTo,
            CreatedDate = incident.CreatedDate
        };

        var assignedUser = Users.FirstOrDefault(u => u.Username == incident.AssignedTo);
        if (assignedUser != null)
        {
            SelectedRole = assignedUser.Role;
            FilteredUsersByRole = Users.Where(u => u.Role == SelectedRole).ToList();
        }

        IsModalOpen = true;
    }

    private void AskDeleteConfirmation(int id)
    {
        pendingIncidentId = id;
        var incident = IncidentService.GetIncident(id);
        confirmDialog.Show("Confirm Delete", $"Are you sure you want to delete incident '{incident?.Title}'?");
    }

    private void ConfirmDelete()
    {
        //IncidentService.DeleteIncident(pendingIncidentId);
