@page "/forgot-password"
@using IncidentManagement.Shared.Models
@using IncidentManagement.WebClient.Components
@layout DashboardLayout
@inject NavigationManager NavManager

<OkComponent @ref="popup" OnOk="RedirectToLogin" />

<div class="signup-container">
    <h2>Forgot Password</h2>
    <p class="subtitle">Enter your account details to reset your password</p>

    <EditForm Model="@resetModel" OnValidSubmit="HandleReset">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <!-- Email -->
        <div class="form-group">
            <label for="email">Email</label>
            <InputText id="email" class="form-control" @bind-Value="resetModel.Email" />
            <ValidationMessage For="@(() => resetModel.Email)" />
        </div>

        <!-- Phone Number -->
        <div class="form-group">
            <label for="phoneNumber">Phone Number</label>
            <InputText id="phoneNumber" class="form-control" @bind-Value="resetModel.PhoneNumber" />
            <ValidationMessage For="@(() => resetModel.PhoneNumber)" />
        </div>

        <!-- WhatsApp Number -->
        <div class="form-group">
            <label for="whatsappNumber">WhatsApp Number</label>
            <InputText id="whatsappNumber" class="form-control" @bind-Value="resetModel.WhatsAppNumber" />
            <ValidationMessage For="@(() => resetModel.WhatsAppNumber)" />
        </div>

        <button type="submit" class="btn-action">Reset Password</button>
    </EditForm>
</div>

@code {
    private User resetModel = new User();
    private OkComponent popup;

    private async Task HandleReset()
    {
        // TODO: Trigger password reset logic (send email/SMS/WhatsApp OTP)

        // Show popup confirmation
        popup.Show("Password Reset", "Instructions to reset your password have been sent.");
    }

    private void RedirectToLogin()
    {
        NavManager.NavigateTo("/login");
    }
}
