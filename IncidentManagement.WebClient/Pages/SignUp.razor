@page "/signup"
@layout DashboardLayout
@using IncidentManagement.Shared.Models
@using IncidentManagement.WebClient.Services
@using IncidentManagement.WebClient.Components
@inject IJSRuntime JS
@inject NavigationManager NavManager
@inject UserService UserService

<OkComponent @ref="popup" OnOk="RedirectToLogin" />

<div class="signup-container">
    <h2>Create Your Account</h2>
    <p class="subtitle">Sign up to access the Incident Management System</p>

    <EditForm Model="@newUser" OnValidSubmit="HandleSignUp">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <!-- Username -->
        <div class="form-group">
            <label for="username">Full Name</label>
            <InputText id="username" class="form-control" @bind-Value="newUser.Username" />
            <ValidationMessage For="@(() => newUser.Username)" />
        </div>

        <!-- Email -->
        <div class="form-group">
            <label for="email">Email</label>
            <InputText id="email" class="form-control" @bind-Value="newUser.Email" />
            <ValidationMessage For="@(() => newUser.Email)" />
        </div>

        <!-- Password -->
        <div class="form-group">
            <label for="password">Password</label>
            <InputText id="password" type="password" class="form-control" @bind-Value="newUser.Password" />
            <ValidationMessage For="@(() => newUser.Password)" />
        </div>

        <!-- Confirm Password -->
        <div class="form-group">
            <label for="confirmPassword">Confirm Password</label>
            <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="newUser.ConfirmPassword" />
            <ValidationMessage For="@(() => newUser.ConfirmPassword)" />
        </div>

        <!-- Phone Number -->
        <div class="form-group">
            <label for="phoneNumber">Phone Number</label>
            <InputText id="phoneNumber" class="form-control" @bind-Value="newUser.PhoneNumber" />
            <ValidationMessage For="@(() => newUser.PhoneNumber)" />
        </div>

        <!-- WhatsApp Number -->
        <div class="form-group">
            <label for="whatsappNumber">WhatsApp Number</label>
            <InputText id="whatsappNumber" class="form-control" @bind-Value="newUser.WhatsAppNumber" />
            <ValidationMessage For="@(() => newUser.WhatsAppNumber)" />
        </div>

        <!-- Role -->
        <div class="form-group">
            <label for="role">Role</label>
            <InputSelect id="role" class="form-control" @bind-Value="newUser.Role">
                <option value="">Select a role</option>                
                <option value="Admin">City Power</option>
                <option value="Agent">Agent</option>
                <option value="Analyst">Estate Manager</option>
                <option value="Manager">Security Contractor</option>
                <option value="Analyst">Tenant</option>                                
            </InputSelect>
            <ValidationMessage For="@(() => newUser.Role)" />
        </div>

        <button type="submit" class="btn-action">Sign Up</button>
    </EditForm>
</div>

@code {
    private User newUser = new User();
    private OkComponent popup;

    private async Task HandleSignUp()
    {
        // Basic password confirmation check
        if (newUser.Password != newUser.ConfirmPassword)
        {
            // handled inline with ValidationMessage
            return;
        }

        // Add the new user into the in-memory list via UserService
        var createdUser = await UserService.CreateUserAsync(new User
        {
            Username = newUser.Username,
            Email = newUser.Email,
            Password = newUser.ConfirmPassword,
            PhoneNumber = newUser.PhoneNumber,
            WhatsAppNumber = newUser.WhatsAppNumber,
            Role = newUser.Role,
            IsActive = true
        });

        // Show popup confirmation
        popup.Show("Sign Up Successful", $"User {createdUser.Username} created successfully!");
    }

    private void RedirectToLogin()
    {
        NavManager.NavigateTo("/login");
    }
}

